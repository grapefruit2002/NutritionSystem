{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nutrition-system",
  "main": "src/index.js",
  // 与 Cloudflare 运行时行为绑定的日期，改动会影响兼容性开关
  "compatibility_date": "2025-11-01",
  // 前端构建产物由同一个 Worker 提供，避免第二个域名与跨域配置
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // 这些路径必须先经过 Worker，否则会被 SPA 回退成 index.html
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nutrition-system-db",
      "database_id": "e6141141-3b46-432d-a5ec-89025571c328"
    }
  ],
  "observability": {
    "enabled": true
  }
}
